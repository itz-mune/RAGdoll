{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAGdoll",
  "version": "0.1.0",
  "identifier": "com.srujan.ragdoll",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RAGdoll",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "backgroundColor": [13, 13, 13, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/main_logo_white.ico"
    ],
    "resources": [
      "../ragdoll.config.json",
      "../public/dictionaries/*"
    ]
  }
}
