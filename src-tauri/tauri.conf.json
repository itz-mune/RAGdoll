{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAGdoll",
  "version": "0.2.1",
  "identifier": "com.mune.ragdoll",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RAGdoll",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "backgroundColor": [
          13,
          13,
          13,
          255
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mune",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/main_logo_white.ico"
    ],
    "resources": [
      "../ragdoll.config.json",
      "../public/dictionaries/*",
      "sidecar-src/**/*"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0OEVFOTgyRTdFNjBDODYKUldTR0RPYm5ndW1PZEtXS0lvWEJpUHlzMmZLVXd1N09SZyt4YnRaaGdwaFJJYktXQ2k0RCt1NncK",
      "endpoints": [
        "https://github.com/itz-mune/RAGdoll/releases/latest/download/latest.json"
      ]
    }
  }
}